<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Balenthiran.SecretProvisioner.EntityModels/Balenthiran.SecretProvisioner.EntityModels.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Abstractions/Balenthiran.SecretProvisioner.Abstractions.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.DataModels/Balenthiran.SecretProvisioner.DataModels.csproj" />
  </ItemGroup>

  <!-- The plain ADO.NET driver, at the version web-template's EF provider pins (10.0.0). No EF
       Core: this service runs DDL against the catalogue and has no tables of its own. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
