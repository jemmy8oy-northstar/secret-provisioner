<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The package set is Kit's (kit#120), which is web-template's test set verbatim. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Services/Balenthiran.SecretProvisioner.Services.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Abstractions/Balenthiran.SecretProvisioner.Abstractions.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.DataModels/Balenthiran.SecretProvisioner.DataModels.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Database/Balenthiran.SecretProvisioner.Database.csproj" />
  </ItemGroup>

</Project>
