[
  {
    "app": "around-the-world",
    "namespace": "balenthiran",
    "secretName": "around-the-world-secrets",
    "keys": [
      {
        "key": "ConnectionStrings__DefaultConnection",
        "type": "postgres-db",
        "database": "aroundtheworld",
        "role": "aroundtheworld"
      },
      {
        "key": "Jwt__Secret",
        "type": "random",
        "bytes": 32
      },
      {
        "key": "Admin__Key",
        "type": "random",
        "bytes": 16
      },
      {
        "key": "PhotoStorage__AccessKeyId",
        "type": "external"
      },
      {
        "key": "PhotoStorage__SecretAccessKey",
        "type": "external"
      }
    ]
  },
  {
    "app": "balenthiran",
    "namespace": "balenthiran",
    "secretName": "balenthiran-secrets",
    "keys": [
      {
        "key": "DATABASE_URL",
        "type": "postgres-db",
        "database": "balenthiran",
        "role": "balenthiran"
      }
    ]
  },
  {
    "app": "macro-metrics",
    "namespace": "balenthiran",
    "secretName": "macro-metrics-secrets",
    "keys": [
      {
        "key": "FRED_API_KEY",
        "type": "external"
      }
    ]
  }
]
