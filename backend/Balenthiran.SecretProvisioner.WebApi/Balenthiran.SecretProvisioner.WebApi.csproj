<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The template's WebApi minus every package, as in Kit: no EF (this service has no tables of
       its own), no AutoMapper, no OpenAPI generator for a three-route internal surface. The
       ASP.NET Core shared framework comes with the Web SDK, so this adds no package. -->
  <PropertyGroup>
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Services/Balenthiran.SecretProvisioner.Services.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.Abstractions/Balenthiran.SecretProvisioner.Abstractions.csproj" />
    <ProjectReference Include="../Balenthiran.SecretProvisioner.DataModels/Balenthiran.SecretProvisioner.DataModels.csproj" />
  </ItemGroup>

</Project>
